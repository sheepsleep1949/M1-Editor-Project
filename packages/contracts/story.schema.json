{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/story-schema-v1.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "rulesVersion": {
      "const": "1.0"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "entryNodeId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "variables": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "kind": {
            "enum": [
              "item",
              "flag"
            ]
          },
          "initial": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "label",
          "kind",
          "initial"
        ]
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "body": {
            "type": "string",
            "maxLength": 10000
          },
          "kind": {
            "enum": [
              "scene",
              "ending"
            ]
          },
          "media": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "backgroundId": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "audioId": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              }
            },
            "required": []
          },
          "choices": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "targetNodeId": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                },
                "conditions": {
                  "type": "array",
                  "maxItems": 8,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "variableId": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                      },
                      "equals": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "variableId",
                      "equals"
                    ]
                  }
                },
                "effects": {
                  "type": "array",
                  "maxItems": 8,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "variableId": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                      },
                      "value": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "variableId",
                      "value"
                    ]
                  }
                }
              },
              "required": [
                "id",
                "label",
                "targetNodeId",
                "conditions",
                "effects"
              ]
            }
          }
        },
        "required": [
          "id",
          "title",
          "body",
          "kind",
          "media",
          "choices"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "rulesVersion",
    "title",
    "entryNodeId",
    "variables",
    "nodes"
  ]
}
