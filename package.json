{
  "name": "campus-story-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "tsc -p tsconfig.json --noEmit && vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "db:deploy": "tsx scripts/db-deploy.ts",
    "db:seed": "tsx scripts/seed.ts",
    "fixtures:check": "tsx scripts/check-fixtures.ts",
    "contracts:check": "tsx scripts/check-contracts.ts",
    "verify": "npm run typecheck && npm test && npm run fixtures:check && npm run contracts:check && npm run build"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "@fastify/cookie": "11.0.2",
    "fastify": "5.6.1",
    "dotenv": "16.6.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "@xyflow/react": "12.8.5",
    "ajv": "8.17.1"
  },
  "devDependencies": {
    "@types/node": "24.7.2",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "vite": "7.1.12",
    "typescript": "5.9.3",
    "tsx": "4.20.6",
    "vitest": "3.2.4",
    "prisma": "6.19.0",
    "concurrently": "9.2.1"
  }
}
