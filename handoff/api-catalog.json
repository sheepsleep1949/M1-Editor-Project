  {
    "method": "GET",
    "path": "/api/v1/sessions/{sessionId}/replay",
    "owner": "M5",
    "summary": "核对规则回放",
    "implemented": false,
    "policy": "沿用事件读取权限；事件异常返回 MISMATCH 与位置，禁止自动补齐或忽略。",
    "body": null,
    "response": {
      "$ref": "#/components/schemas/Replay"
    }
