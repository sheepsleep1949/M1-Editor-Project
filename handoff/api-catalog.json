  {
    "method": "POST",
    "path": "/api/v1/sessions/{sessionId}/feedback",
    "owner": "M5",
    "summary": "提交节点反馈",
    "implemented": false,
    "policy": "仅本人；先明确开启 shareWithCreator 才提交；seq=0 对应初始状态，seq=k 对应事件 k 之后。服务端重核 nodeId/versionId。",
    "body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "eventSeq": {
          "type": "integer",
          "minimum": 0
        },
        "nodeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "category": {
          "type": "string",
          "enum": [
            "bug",
            "confusing",
            "suggestion"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "requestId",
        "eventSeq",
        "nodeId",
        "category",
        "text"
      ]
    },
    "response": {
      "$ref": "#/components/schemas/Feedback"
    }
  },
